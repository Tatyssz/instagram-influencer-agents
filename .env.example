# Copie para .env e preencha após criar o app em developers.facebook.com

# Facebook App (Configurações do app > Básico)
META_APP_ID=

# Instagram Login (Instagram > API setup > Business login settings)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# OAuth — Meta exige https:// (não use http://)
OAUTH_REDIRECT_URI=https://localhost:8765/callback

# Preenchidos automaticamente após: python scripts/sync_instagram.py auth
META_ACCESS_TOKEN=
IG_USER_ID=
